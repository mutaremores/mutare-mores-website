{
  // Deploys this repo as a Cloudflare Worker: src/worker.js just serves
  // the static files built into public/ (via the ASSETS binding).
  // Content comes from Notion now -- see scripts/notion-sync.mjs and
  // .github/workflows/notion-sync.yml.
  "name": "mutare-mores-website",
  "compatibility_date": "2026-08-02",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
