{
  // Deploys this repo as a Cloudflare Worker: src/worker.js just serves
  // the static files built into public/ (via the ASSETS binding).
  // Content comes from Notion now -- see scripts/notion-sync.mjs and
  // .github/workflows/notion-sync.yml.
  "name": "mutare-mores-website",
  "compatibility_date": "2026-08-02",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // By default Cloudflare serves static-asset requests directly from its
    // asset store and skips the Worker's fetch() handler entirely -- so the
    // security headers added there (see src/worker.js) never got attached.
    // This forces every request through fetch() first.
    "run_worker_first": true,
    // Serves public/404.html (instead of a bare empty 404 body) for any
    // path that doesn't match a real file.
    "not_found_handling": "404-page"
  }
}
